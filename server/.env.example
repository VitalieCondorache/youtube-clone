# Copy to .env and adjust for your machine: cp .env.example .env

# Port the API listens on. Do not use 5000 on macOS: the AirPlay Receiver
# (ControlCenter) already listens there and replies with an empty 403.
PORT=5001

MONGO_URI=mongodb://localhost:27017/youtube-clone
JWT_SECRET=replace-with-a-long-random-secret

# Access tokens are short lived, the client silently exchanges the refresh token for a new one
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Where the uploaded files are stored:
#   local -> server/src/uploads, served at /uploads (default, nothing else to configure)
#   s3    -> any S3 compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_DRIVER=local

# Only used when STORAGE_DRIVER=s3. Example for Cloudflare R2, MinIO works the same
# with its own endpoint.
# S3_BUCKET=youtube-clone-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://pub-<id>.r2.dev
# S3_PREFIX=uploads
