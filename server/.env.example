# Copy to .env and adjust for your machine: cp .env.example .env

# Port the API listens on. Do not use 5000 on macOS: the AirPlay Receiver
# (ControlCenter) already listens there and replies with an empty 403.
PORT=5001

MONGO_URI=mongodb://localhost:27017/youtube-clone
JWT_SECRET=replace-with-a-long-random-secret
